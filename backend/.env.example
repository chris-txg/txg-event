# Useful Docker Commands:
# docker compose up --build  
# docker compose logs -f backend --tail=100
# docker compose logs -f celery_worker --tail=100
# docker compose logs -f postgres --tail=100
# docker compose exec postgres psql -U postgres -d txg-event
# docker compose logs -f redis --tail=50
# docker compose exec redis redis-cli ping
# docker compose exec redis redis-cli llen celery
# ==============================================
# Environment Configuration (.env)
# ==============================================

# PostgreSQL Database
POSTGRES_DB=txg-event
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & Caching
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Django Application
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-key-secret!
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Email & SMTP Configuration
# In Development: defaults to console (prints email in terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@eventplatform.com

# In Production: uncomment and provide your SMTP details (e.g., SendGrid, Brevo, AWS SES, Gmail)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_actual_smtp_password_or_api_key



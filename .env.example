#Commands
docker compose up --build  
docker compose logs -f backend --tail=100
docker compose logs -f celery_worker --tail=100
docker compose logs -f postgres --tail=100
docker compose exec postgres psql -U postgres -d txg-event
SELECT pid, query, state, age(clock_timestamp(), query_start) 
FROM pg_stat_activity 
WHERE state != 'idle' AND age(clock_timestamp(), query_start) > interval '5 seconds';
docker compose logs -f redis --tail=50
docker compose exec redis redis-cli ping
# Output: PONG
docker compose exec redis redis-cli llen celery
# ==============================================
# Environment Configuration (.env)
# ==============================================

# PostgreSQL Database
POSTGRES_DB=txg-event
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & Caching
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Django Application
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-key-secret!
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000



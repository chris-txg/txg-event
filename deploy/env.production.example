# ==============================================================
# Production Environment Configuration (.env)
# Domains:
#   Frontend: https://event-marketplace.tecnolynx.com
#   Backend:  https://api.event-marketplace.tecnolynx.com
# For Staging:
#   Frontend: https://staging-event.tecnolynx.com
#   Backend:  https://api.staging-event.tecnolynx.com
# ==============================================================

# Container Host Port Bindings (change if other projects use 3000/8000)
FRONTEND_PORT=3000
BACKEND_PORT=8000

# PostgreSQL Database (Runs securely inside the Docker network)
POSTGRES_DB=txg_event_prod
POSTGRES_USER=txg_admin
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_RANDOM_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & Caching
REDIS_URL=redis://redis:6379/0

# Celery Task Queue
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=django-db

# Django Security Settings
DJANGO_SECRET_KEY=CHANGE_THIS_TO_A_50_CHAR_RANDOM_SECRET_KEY!
DJANGO_DEBUG=False

# Allowed Hosts for tecnolynx subdomains
DJANGO_ALLOWED_HOSTS=api.event-marketplace.tecnolynx.com,event-marketplace.tecnolynx.com,api.staging-event.tecnolynx.com,staging-event.tecnolynx.com,127.0.0.1,backend

# Frontend & CORS URLs
FRONTEND_URL=https://event-marketplace.tecnolynx.com
NEXT_PUBLIC_API_URL=https://api.event-marketplace.tecnolynx.com
CORS_ALLOWED_ORIGINS=https://event-marketplace.tecnolynx.com,https://staging-event.tecnolynx.com
CSRF_TRUSTED_ORIGINS=https://event-marketplace.tecnolynx.com,https://api.event-marketplace.tecnolynx.com,https://staging-event.tecnolynx.com,https://api.staging-event.tecnolynx.com

# Razorpay Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_MERCHANT_ID=your_merchant_id
RAZORPAY_ACCOUNT_NUMBER=your_account_number
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
SURVEY_PUBLISH_FEE_INR=499

# Email & SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=ecomap91@gmail.com
EMAIL_HOST_PASSWORD=dpiw soyg owtu gkca
DEFAULT_FROM_EMAIL=noreply@tecnolynx.com
